---
import { docHref, getDocs } from '@/lib/site'

export async function getStaticPaths() {
  const modern = await getDocs('modern')
  const legacy = await getDocs('legacy')
  return [
    ...legacy.map((doc) => ({ params: { slug: doc.id }, props: { href: docHref(doc, 'legacy') } })),
    ...modern
      .filter((doc) => !legacy.some((entry) => entry.id === doc.id))
      .map((doc) => ({ params: { slug: doc.id }, props: { href: docHref(doc, 'modern') } })),
  ]
}

type Props = { href: string }
return Astro.redirect(Astro.props.href, 301)
---
