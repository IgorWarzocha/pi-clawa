---
import { marked } from 'marked'
import EditionSwitch from '@/components/edition-switch.astro'
import BaseLayout from '@/layouts/base-layout.astro'
import { readChangelog } from '@/lib/changelog'
import { type Edition, editions, withBase } from '@/lib/site'

export function getStaticPaths() {
  return editions.map((track) => ({ params: { edition: track }, props: { edition: track } }))
}

type Props = { edition: Edition }
const { edition } = Astro.props
const editionName = edition === 'modern' ? 'Modern' : 'Legacy'
const html = await marked.parse(await readChangelog(edition))
const markdownHref = withBase(`/${edition}/changelog.md`)
---

<BaseLayout title={`${editionName} changelog`} description="Tagged releases and unreleased changes to Clawa." current="changelog" edition={edition} markdownHref={markdownHref} type="article">
  <main id="main-content" class="site-shell standalone-page" tabindex="-1">
    <EditionSwitch edition={edition} modernHref={withBase('/modern/changelog/')} legacyHref={withBase('/legacy/changelog/')} />
    <header class="doc-header">
      <h1>{editionName} changelog</h1>
      <p class="lede">{edition === 'modern'
        ? 'Modern changes are unreleased. The 0.3.0 release below belongs to legacy.'
        : 'The release history preserved with the legacy branch. Modern development has its own changelog.'}</p>
    </header>
    <article class="prose changelog" set:html={html} />
    <footer class="doc-footer"><a href={markdownHref}>Read as Markdown</a></footer>
  </main>
</BaseLayout>
