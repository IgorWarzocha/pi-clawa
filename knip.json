{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["tests/*.test.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/pi-clawa-discord": {
      "entry": ["*.test.ts", "src/gateway/cli/index.ts"],
      "project": ["*.test.ts", "src/**/*.ts"],
      "ignoreDependencies": ["pino-pretty", "tsx"]
    },
    "website": {
      "project": ["src/**/*.{ts,astro}"]
    }
  }
}
