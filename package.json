{
  "name": "@howaboua/pi-clawa",
  "version": "0.3.0",
  "type": "module",
  "description": "Redistributable Pi extension package for the Clawa/Clawas runtime.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "clawas",
    "clawa"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "bun run typecheck",
    "test": "node --import tsx --test tests/*.test.ts src/clawas/*.test.ts src/clawas/comms/*.test.ts packages/pi-clawa-discord/*.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:strict": "biome check --error-on-warnings .",
    "knip": "knip",
    "deadcode": "knip",
    "docs:dev": "bun --cwd website dev",
    "docs:build": "bun --cwd website build",
    "ai:check": "bun run check",
    "ai:check:strict": "bun run check",
    "check": "bun run lint:strict && bun run typecheck && bun run knip && bun run test && bun run docs:build"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "website/src/content/docs/**/*.md",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "templates/**",
    "skills/**",
    "!skills/**/__pycache__/**",
    "!skills/**/*.pyc",
    "!skills/**/*.pyo",
    "install/**",
    "scripts/**"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.2",
    "@earendil-works/pi-tui": ">=0.99.2",
    "@howaboua/pi-codex-conversion": ">=3.0.42",
    "typebox": "*",
    "@earendil-works/pi-ai": ">=0.99.2"
  },
  "peerDependenciesMeta": {
    "@howaboua/pi-codex-conversion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@howaboua/pi-codex-conversion": "3.0.42",
    "@types/node": "26.1.1",
    "tsx": "^4.23.1",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "knip": "6.26.0",
    "@earendil-works/pi-ai": "0.99.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.15.0 <27"
  },
  "workspaces": [
    "packages/*",
    "website"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./jsonc": "./src/jsonc.ts"
  }
}
