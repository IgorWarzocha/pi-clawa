{
  "name": "@howaboua/pi-clawa-discord",
  "version": "0.4.0",
  "type": "module",
  "description": "Give each Clawa its own Discord bot in its visible Pi session.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "clawa",
    "discord"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "README.md",
    "DISCORD-BOT-SETUP.md",
    "LICENSE",
    "NOTICE.md",
    "index.ts",
    "src/**"
  ],
  "exports": {
    ".": "./index.ts"
  },
  "dependencies": {
    "discord.js": "^14.26.5",
    "dotenv": "^17.4.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.2",
    "@earendil-works/pi-ai": ">=0.99.2",
    "@earendil-works/pi-tui": ">=0.99.2",
    "typebox": "*",
    "@howaboua/pi-codex-conversion": ">=3.0.42"
  },
  "devDependencies": {
    "@howaboua/pi-codex-conversion": "3.0.42"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.15.0 <27"
  },
  "peerDependenciesMeta": {
    "@howaboua/pi-codex-conversion": {
      "optional": true
    }
  }
}
